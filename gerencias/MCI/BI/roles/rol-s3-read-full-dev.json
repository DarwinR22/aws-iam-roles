{
  "role_name": "rol-s3-read-full-dev",
  "description": "Rol para S3 - acceso de lectura completa en ambiente dev - Incluye múltiples buckets de analytics",
  "trust_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "ec2.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      }
    ]
  },
  "policies": {
    "generic_policy": "MCI-S3-ReadOnly",
    "specific_resources": [
      "arn:aws:s3:::s3-data-analytics-raw-dev-tfstate",
      "arn:aws:s3:::s3-data-analytics-processed-dev",
      "arn:aws:s3:::s3-bi-reports-dev",
      "arn:aws:s3:::s3-mci-backups-dev"
    ]
  },
  "tags": {
    "ambiente": "dev",
    "pais": "GT",
    "direccion": "Tecnologia",
    "gerencia": "MCI",
    "cuenta": "Desarrollo",
    "modulo": "Aplicacion",
    "alcance_sox": "No",
    "propietario": "Darwin Lopez",
    "proveedor": "Interno",
    "layer": "s3",
    "dominio": "BI",
    "subdominio": "read-full",
    "aplicacion": "BI-read-full",
    "soporte": "DevOps",
    "contacto": "darwin.lopez@claro.com.gt",
    "proyecto": "MCI-BI",
    "creado_por": "Darwin Lopez",
    "ciclo_vida": "Actualizacion",
    "version": "1.0.7",
    "ultima_modificacion": "2025-09-18"
  },
  "note": "Este rol usa la política genérica 'MCI-S3-ReadOnly' con múltiples buckets S3 para analytics y BI en desarrollo."
}