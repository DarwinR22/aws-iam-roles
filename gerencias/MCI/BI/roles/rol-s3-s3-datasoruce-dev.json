{
  "role_name": "rol-s3-s3-datasoruce-dev",
  "description": "Rol con trust lambda - s3-datasoruce en ambiente dev",
  "trust_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "lambda.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      }
    ]
  },
  "policies": {
    "aws_managed": [],
    "custom": [
      "MCI-S3-Write",
      "MCI-Lambda-Invoke"
    ]
  },
  "policy_resources": {
    "MCI-S3-ReadOnly": [
      "arn:aws:s3:::s3-data-analytics-raw-dev-tfstate"
    ],
    "MCI-S3-Write": [
      "arn:aws:s3:::s3-data-analytics-raw-dev-tfstate"
    ]
  },
  "tags": {
    "ambiente": "dev",
    "pais": "RG",
    "direccion": "TICenam",
    "gerencia": "MCI",
    "cuenta": "Desarrollo",
    "modulo": "Aplicacion",
    "alcance_sox": "No",
    "propietario": "DarwinLopez",
    "proveedor": "INHOUSE",
    "layer": "s3",
    "dominio": "BI",
    "subdominio": "s3-datasoruce",
    "aplicacion": "BI-s3-datasoruce",
    "soporte": "DevOps",
    "contacto": "darwin.lopez@claro.com.gt",
    "proyecto": "cubo-prepago",
    "creado_por": "DarwinLopez",
    "ciclo_vida": "Creacion",
    "version": "1.0.0"
  },
  "note": "Rol con trust relationship 'lambda' y políticas: MCI-S3-ReadOnly, MCI-S3-Write. Recursos específicos definidos por política."
}