# Auto-generated role: {{ role.name }}
# Generated from: {{ source_file }}
# DO NOT EDIT MANUALLY - Changes will be overwritten
# Last update: 2025-10-09 - Added complete tags for SCP compliance

# Get current AWS account ID
data "aws_caller_identity" "current" {}

# Trust policy for the role (using jsonencode to preserve array format)
{% if role.trust_policy.type == "oidc" %}
locals {
  {{ role.terraform_name }}_trust_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Federated = "{{ role.trust_policy.oidc_config.provider_arn | replace('${account_id}', '${data.aws_caller_identity.current.account_id}') }}"
      }
      Action = "sts:AssumeRoleWithWebIdentity"
      Condition = {
        {% for condition in role.trust_policy.oidc_config.conditions %}
        {{ condition['test'] }} = {
          "{{ condition['variable'] }}" = [
            {% for value in condition['values'] %}
            "{{ value }}"{{ "," if not loop.last else "" }}
            {% endfor %}
          ]
        }{{ "," if not loop.last else "" }}
        {% endfor %}
      }
    }]
  })
}
{% else %}
# Trust policy for the role
data "aws_iam_policy_document" "{{ role.terraform_name }}_trust" {
  {% for trust in role.trust_policy %}
  statement {
    effect = "Allow"
    
    principals {
      {% if trust.service %}
      type        = "Service"
      identifiers = ["{{ trust.service }}"]
      {% elif trust.federated %}
      type        = "Federated" 
      identifiers = ["{{ trust.federated }}"]
      {% elif trust.aws %}
      type        = "AWS"
      identifiers = ["{{ trust.aws }}"]
      {% endif %}
    }

    actions = [
      {% if trust.service %}
      "sts:AssumeRole"
      {% elif trust.federated %}
      "sts:AssumeRoleWithWebIdentity"
      {% elif trust.aws %}
      "sts:AssumeRole"
      {% endif %}
    ]

    {% if trust.condition %}
    condition {
      test     = "{{ trust.condition.test }}"
      variable = "{{ trust.condition.variable }}"
      values   = [
        {% if trust.condition.values is iterable and trust.condition.values is not string %}
          {% for value in trust.condition.values %}
        "{{ value }}",
          {% endfor %}
        {% else %}
        "{{ trust.condition.values }}",
        {% endif %}
      ]
    }
    {% endif %}
  }
  {% endfor %}
}
{% endif %}

# IAM Role
resource "aws_iam_role" "{{ role.terraform_name }}" {
  name               = "{{ role.name }}"
  description        = "{{ role.description }}"
  {% if role.trust_policy.type == "oidc" %}
  assume_role_policy = local.{{ role.terraform_name }}_trust_policy
  {% else %}
  assume_role_policy = data.aws_iam_policy_document.{{ role.terraform_name }}_trust.json
  {% endif %}

  {% if role.max_session_duration %}
  max_session_duration = {{ role.max_session_duration }}
  {% endif %}

  tags = {
    {% for key, value in role.tags.items() %}
    "{{ key }}" = "{{ value }}"
    {% endfor %}
    # Auto-generated tags
    "ManagedBy" = "terraform"
    "Source"    = "{{ source_file }}"
    "Generated" = "{{ generation_time }}"
  }
}

# Create policies as independent modules (not attached to role)
{% for policy_name in role.policies %}
{% set terraform_name = (policy_name | lower | replace('-', '_')) %}
module "{{ terraform_name }}" {
  source = "./modules/policies/{{ terraform_name }}"
  
  environment = "{{ role.tags.Ambiente | default('dev') }}"
  
  # ABAC conditions for policy restrictions
  abac_conditions = {
    "aws:PrincipalTag/Gerencia" = ["{{ role.tags.Gerencia }}"]
    "aws:PrincipalTag/Area"     = ["{{ role.tags.Area }}"]
    "aws:PrincipalTag/Ambiente" = ["{{ role.tags.Ambiente }}"]
  }
  
  # AWS Configuration
  aws_region            = "us-east-1"
  role_prefix          = "APP-"
  policy_prefix        = "APP-"
  s3_bucket_name       = "terraform-state-bucket-051963532279"
  dynamodb_table_name  = "terraform-locks"
  kms_key_id          = "*"
  
  common_tags = {
    "Pais" = "{{ role.tags.Pais }}"
    "Gerencia" = "{{ role.tags.Gerencia }}"
    "Area" = "{{ role.tags.Area }}"  
    "Ambiente" = "{{ role.tags.Ambiente }}"
    "Direccion" = "{{ role.tags.Direccion | default('TIRegional') }}"
    "Modulo" = "{{ role.tags.Modulo | default('IAM') }}"
    "Alcance SOX" = "{{ role.tags['Alcance SOX'] | default('No') }}"
    "Propietario" = "{{ role.tags.Propietario | default('') }}"
    "Proveedor" = "{{ role.tags.Proveedor | default('InHouse') }}"
    "Layer" = "{{ role.tags.Layer | default('') }}"
    "Dominio" = "{{ role.tags.Dominio | default('') }}"
    "Subdominio" = "{{ role.tags.Subdominio | default('') }}"
    "Aplicacion" = "{{ role.tags.Aplicacion | default('') }}"
    "Tipo de Recurso" = "IAMPolicy"
    "Soporte" = "{{ role.tags.Soporte | default('') }}"
    "Contacto" = "{{ role.tags.Contacto | default('') }}"
    "Creado Por" = "{{ role.tags['Creado Por'] | default('') }}"
    "Ciclo de Vida" = "Creacion"
    "ManagedBy" = "terraform"
  }
}
{% endfor %}

# Attach policies to role
{% for policy_name in role.policies %}
{% set terraform_name = (policy_name | lower | replace('-', '_')) %}
resource "aws_iam_role_policy_attachment" "{{ role.terraform_name }}_{{ terraform_name }}" {
  role       = aws_iam_role.{{ role.terraform_name }}.name
  policy_arn = module.{{ terraform_name }}.policy_arn
}
{% endfor %}

