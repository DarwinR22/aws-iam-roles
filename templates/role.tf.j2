# Auto-generated role: {{ role.name }}
# Generated from: {{ source_file }}
# DO NOT EDIT MANUALLY - Changes will be overwritten

# Get current AWS account ID
data "aws_caller_identity" "current" {}

# Trust policy for the role
data "aws_iam_policy_document" "{{ role.terraform_name }}_trust" {
  {% if role.trust_policy.type == "oidc" %}
  # OIDC Trust Policy for GitHub Actions
  statement {
    effect = "Allow"
    
    principals {
      type        = "Federated"
      identifiers = ["{{ role.trust_policy.oidc_config.provider_arn | replace('${account_id}', '${data.aws_caller_identity.current.account_id}') }}"]
    }

    actions = ["sts:AssumeRoleWithWebIdentity"]

    {% for condition in role.trust_policy.oidc_config.conditions %}
    condition {
      test     = "{{ condition['test'] }}"
      variable = "{{ condition['variable'] }}"
      values   = [
        {% for value in condition['values'] %}
        "{{ value }}"{{ "," if not loop.last else "" }}
        {% endfor %}
      ]
    }
    {% endfor %}
  }
  {% else %}
  # Standard Trust Policy
  {% for trust in role.trust_policy %}
  statement {
    effect = "Allow"
    
    principals {
      {% if trust.service %}
      type        = "Service"
      identifiers = ["{{ trust.service }}"]
      {% elif trust.federated %}
      type        = "Federated" 
      identifiers = ["{{ trust.federated }}"]
      {% elif trust.aws %}
      type        = "AWS"
      identifiers = ["{{ trust.aws }}"]
      {% endif %}
    }

    {% if trust.condition %}
    condition {
      test     = "{{ trust.condition.test }}"
      variable = "{{ trust.condition.variable }}"
      values   = [
        {% if trust.condition.values is iterable and trust.condition.values is not string %}
          {% for value in trust.condition.values %}
        "{{ value }}",
          {% endfor %}
        {% else %}
        "{{ trust.condition.values }}",
        {% endif %}
      ]
    }
    {% endif %}
  }
  {% endfor %}
  {% endif %}
}

# IAM Role
resource "aws_iam_role" "{{ role.terraform_name }}" {
  name               = "{{ role.name }}"
  description        = "{{ role.description }}"
  assume_role_policy = data.aws_iam_policy_document.{{ role.terraform_name }}_trust.json

  {% if role.max_session_duration %}
  max_session_duration = {{ role.max_session_duration }}
  {% endif %}

  tags = {
    {% for key, value in role.tags.items() %}
    "{{ key }}" = "{{ value }}"
    {% endfor %}
    # Auto-generated tags
    "ManagedBy" = "terraform"
    "Source"    = "{{ source_file }}"
    "Generated" = "{{ generation_time }}"
  }
}

# Create policies as independent modules (not attached to role)
{% for policy_name in role.policies %}
{% set terraform_name = (policy_name | lower | replace('-', '_')) %}
module "{{ terraform_name }}" {
  source = "./modules/policies/mci_{{ terraform_name }}"
  
  environment = "{{ role.tags.Ambiente | default('dev') }}"
  
  # ABAC conditions for policy restrictions
  abac_conditions = {
    "aws:PrincipalTag/Gerencia" = ["{{ role.tags.Gerencia }}"]
    "aws:PrincipalTag/Area"     = ["{{ role.tags.Area }}"]
    "aws:PrincipalTag/Ambiente" = ["{{ role.tags.Ambiente }}"]
  }
  
  # AWS Configuration
  aws_region            = "us-east-1"
  role_prefix          = "MCI-"
  policy_prefix        = "MCI-"
  s3_bucket_name       = "mci-terraform-state"
  dynamodb_table_name  = "mci-terraform-locks"
  kms_key_id          = "*"
  
  common_tags = {
    "Gerencia" = "{{ role.tags.Gerencia }}"
    "Area" = "{{ role.tags.Area }}"  
    "Ambiente" = "{{ role.tags.Ambiente }}"
  }
}
{% endfor %}

# To attach policies to role later, manually add:
# resource "aws_iam_role_policy_attachment" "role_policy" {
#   role       = aws_iam_role.{{ role.terraform_name }}.name  
#   policy_arn = module.POLICY_MODULE.policy_arn
# }

# Output role ARN
output "{{ role.terraform_name }}_arn" {
  description = "ARN of {{ role.name }} role"
  value       = aws_iam_role.{{ role.terraform_name }}.arn
}