{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3PathWriteTemplate",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${bucket_name}",
        "arn:aws:s3:::${bucket_name}/${path_prefix}/*"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["${path_prefix}/*"]
        }
      }
    }
  ]
}
