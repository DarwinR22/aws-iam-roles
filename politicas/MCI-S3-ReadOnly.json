{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadOnlyGlobal",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": "*"
    }
  ]
}
