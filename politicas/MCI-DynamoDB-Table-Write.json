{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTableWriteTemplate",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream",
        "dynamodb:ListStreams"
      ],
      "Resource": [
        "arn:aws:dynamodb:${aws_region}:${account_id}:table/${table_name}",
        "arn:aws:dynamodb:${aws_region}:${account_id}:table/${table_name}/index/*",
        "arn:aws:dynamodb:${aws_region}:${account_id}:table/${table_name}/stream/*"
      ]
    },
    {
      "Sid": "DynamoDBListTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables"
      ],
      "Resource": "*"
    }
  ]
}
