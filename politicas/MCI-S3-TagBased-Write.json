{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3TagBasedWriteAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion", 
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketVersioning",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::*",
        "arn:aws:s3:::*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Equipo": "${team_name}",
          "aws:ResourceTag/Ambiente": "${environment}",
          "aws:ResourceTag/Proyecto": "${project_name}"
        }
      }
    },
    {
      "Sid": "S3ListBucketsForDiscovery",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:GetBucketTagging"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUntaggedBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::*", 
        "arn:aws:s3:::*/*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/Equipo": "true"
        }
      }
    },
    {
      "Sid": "DenyWrongEnvironmentS3",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::*",
        "arn:aws:s3:::*/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Ambiente": "${environment}"
        }
      }
    },
    {
      "Sid": "DenyWrongTeamS3",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::*",
        "arn:aws:s3:::*/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/Equipo": "${team_name}"
        }
      }
    }
  ]
}
