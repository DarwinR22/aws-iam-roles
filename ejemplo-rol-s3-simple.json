  "role_name": "rol-s3reader-api-dev-lambda",
  "description": "Rol para Lambda que lee objetos de buckets S3",
  "trust_policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "lambda.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      }
    ]
