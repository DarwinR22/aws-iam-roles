{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSConfigBucketPermissionsCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::sgsi-dev-logs",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "051963532279"
        }
      }
    },
    {
      "Sid": "AWSConfigBucketExistenceCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sgsi-dev-logs",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "051963532279"
        }
      }
    },
    {
      "Sid": "AWSConfigBucketDelivery",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::sgsi-dev-logs/config/AWSLogs/051963532279/Config/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "AWS:SourceAccount": "051963532279"
        }
      }
    },
    {
      "Sid": "AWSConfigBucketDeliveryCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "config.amazonaws.com"
      },
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::sgsi-dev-logs",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "051963532279"
        }
      }
    }
  ]
}